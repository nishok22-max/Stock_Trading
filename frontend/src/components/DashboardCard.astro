---
interface Props {
  id?: string;
  label: string;
  value?: string;
  change?: string;
  trend?: 'up' | 'down' | 'neutral';
  subtext?: string;
  loading?: boolean;
  error?: boolean;
  icon?: string;
}

const {
  id,
  label,
  value = '—',
  change,
  trend = 'neutral',
  subtext,
  loading = false,
  error = false,
  icon,
} = Astro.props;
---

<div class="dash-card" id={id}>
  <div class="card-header">
    <span class="card-label">{label}</span>
    {icon && (
      <span class="card-icon" aria-hidden="true">{icon}</span>
    )}
  </div>

  <div class="card-body">
    {error ? (
      <div class="card-error">Failed to load</div>
    ) : (
      <strong class:list={['card-value', { skeleton: loading }]}>{value}</strong>
    )}

    {(change || subtext) && (
      <div class="card-meta">
        {change && (
          <span class:list={['card-change', trend]}>
            {trend === 'up' && '▲'}
            {trend === 'down' && '▼'}
            {trend === 'neutral' && '•'}
            {' '}{change}
          </span>
        )}
        {subtext && <span class="card-subtext">{subtext}</span>}
      </div>
    )}
  </div>
</div>

<style>
  .dash-card {
    background: #ffffff;
    border: 1px solid #dfe5db;
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    box-shadow: 0 1px 3px rgba(36, 52, 44, 0.04);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .dash-card:hover {
    box-shadow: 0 4px 12px rgba(36, 52, 44, 0.06);
    transform: translateY(-1px);
  }
  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }
  .card-label {
    font-size: 0.75rem;
    color: #6e7a6d;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .card-icon {
    font-size: 1.125rem;
  }
  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .card-value {
    font-size: 1.625rem;
    font-weight: 600;
    font-family: var(--font-mono, monospace);
    color: #1a2720;
    letter-spacing: -0.02em;
  }
  .card-error {
    color: #dc2626;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    flex-wrap: wrap;
  }
  .card-change {
    font-weight: 600;
    font-family: var(--font-mono, monospace);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
  }
  .card-change.up {
    color: #15803d;
    background: #ecfdf5;
  }
  .card-change.down {
    color: #b91c1c;
    background: #fef2f2;
  }
  .card-change.neutral {
    color: #4b5563;
    background: #f3f4f6;
  }
  .card-subtext {
    color: #7d897c;
  }
  .skeleton {
    color: transparent !important;
    background: linear-gradient(90deg, #edf1ea 25%, #e1e7dc 50%, #edf1ea 75%);
    background-size: 200% 100%;
    animation: skeleton-pulse 1.5s infinite;
    border-radius: 4px;
    display: inline-block;
    min-width: 100px;
    height: 1.75rem;
  }
  @keyframes skeleton-pulse {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
</style>

