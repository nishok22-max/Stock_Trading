---
interface StockItem {
  symbol: string;
  companyName: string;
  sector?: string;
  currentPrice: number;
  priceChange: number;
  percentageChange: number;
  active?: boolean;
}

interface Props {
  id?: string;
  stocks?: StockItem[];
  loading?: boolean;
  emptyMessage?: string;
}

const {
  id = 'stock-table',
  stocks = [],
  loading = false,
  emptyMessage = 'No stocks available at this time.',
} = Astro.props;
---

<div class="table-container" id={id}>
  <div class="table-scroll">
    <table class="stock-table">
      <thead>
        <tr>
          <th>Stock</th>
          <th>Sector</th>
          <th class="text-right">Price (₹)</th>
          <th class="text-right">Day Change (₹)</th>
          <th class="text-right">Change (%)</th>
          <th class="text-center">Action</th>
        </tr>
      </thead>
      <tbody id={`${id}-body`}>
        {loading ? (
          <tr>
            <td colspan="6" class="state-cell">
              <div class="loading-state">
                <span class="spinner"></span>
                <span>Loading live stock quotes…</span>
              </div>
            </td>
          </tr>
        ) : stocks.length === 0 ? (
          <tr>
            <td colspan="6" class="state-cell">
              <div class="empty-state">
                <p>{emptyMessage}</p>
              </div>
            </td>
          </tr>
        ) : (
          stocks.map(s => {
            const isUp = s.priceChange > 0;
            const isDown = s.priceChange < 0;
            return (
              <tr class="stock-row">
                <td class="symbol-cell">
                  <strong>{s.symbol}</strong>
                  <span class="company-name">{s.companyName}</span>
                </td>
                <td class="sector-cell">{s.sector || 'General'}</td>
                <td class="text-right price-cell font-mono">
                  ₹{Number(s.currentPrice).toFixed(2)}
                </td>
                <td class:list={['text-right font-mono', { positive: isUp, negative: isDown }]}>
                  {isUp && '+'}₹{Number(s.priceChange).toFixed(2)}
                </td>
                <td class:list={['text-right font-mono font-semibold', { positive: isUp, negative: isDown }]}>
                  {isUp && '+'}
                  {Number(s.percentageChange).toFixed(2)}%
                </td>
                <td class="text-center">
                  <a href={`/?symbol=${s.symbol}`} class="trade-btn">
                    Trade
                  </a>
                </td>
              </tr>
            );
          })
        )}
      </tbody>
    </table>
  </div>
</div>

<style>
  .table-container {
    background: #ffffff;
    border: 1px solid #dfe5db;
    border-radius: 12px;
    overflow: hidden;
  }
  .table-scroll {
    overflow-x: auto;
    width: 100%;
  }
  .stock-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8125rem;
    white-space: nowrap;
  }
  th {
    background: #f7f9f5;
    color: #6d786c;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #e2e8de;
    text-align: left;
  }
  td {
    padding: 0.875rem 1rem;
    border-bottom: 1px solid #edf1ea;
    color: #24342c;
  }
  tr.stock-row:last-child td {
    border-bottom: none;
  }
  tr.stock-row:hover td {
    background: #f8faf6;
  }
  .text-right {
    text-align: right;
  }
  .text-center {
    text-align: center;
  }
  .font-mono {
    font-family: var(--font-mono, monospace);
  }
  .font-semibold {
    font-weight: 600;
  }
  .symbol-cell strong {
    display: block;
    color: #17261d;
    font-size: 0.875rem;
  }
  .company-name {
    display: block;
    font-size: 0.75rem;
    color: #7b887a;
    margin-top: 0.125rem;
  }
  .sector-cell {
    color: #5c685b;
  }
  .positive {
    color: #15803d;
  }
  .negative {
    color: #b91c1c;
  }
  .trade-btn {
    display: inline-block;
    background: #276148;
    color: #ffffff;
    font-size: 0.6875rem;
    font-weight: 600;
    padding: 0.25rem 0.625rem;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .trade-btn:hover {
    background: #1c4835;
  }
  .state-cell {
    text-align: center;
    padding: 2.5rem 1rem;
    color: #7a8779;
  }
  .loading-state {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }
  .spinner {
    width: 18px;
    height: 18px;
    border: 2px solid #dce2db;
    border-top-color: #276148;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .empty-state p {
    font-size: 0.875rem;
  }
</style>

