---
import MainLayout from '../layouts/MainLayout.astro';
import PortfolioSummary from '../components/PortfolioSummary.astro';
import HoldingsTable from '../components/HoldingsTable.astro';
import AllocationChart from '../components/AllocationChart.astro';
import { getPortfolio, DEFAULT_USER_ID } from '../scripts/api.js';

const portfolio = await getPortfolio(DEFAULT_USER_ID);
---

<MainLayout title="Portfolio & Holdings" activeNav="portfolio">
  <!-- Top KPI Overview Cards -->
  <PortfolioSummary
    investedValue={portfolio.totalInvestedValue}
    currentValue={portfolio.totalCurrentValue}
    unrealizedPnL={portfolio.totalUnrealizedProfitLoss}
    returnPercentage={portfolio.totalReturnPercentage}
    isMockData={portfolio.isMockData}
  />

  <!-- Main Grid: Holdings Table & Allocation Chart -->
  <div class="dashboard-split" style="margin-bottom: 2rem;">
    <div class="table-container">
      <HoldingsTable holdings={portfolio.holdings} />
    </div>
    <div class="chart-section">
      <AllocationChart holdings={portfolio.holdings} />
    </div>
  </div>

  <!-- Interactive Member 5 Integration Simulation Card -->
  <div class="card">
    <div class="table-header-row" style="margin-bottom: 0.75rem;">
      <div>
        <h3>⚡ Member 5 Integration: Simulate Executed Trade</h3>
        <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 2px;">
          Simulate receiving a completed trade across the integration boundary to test weighted average updates
        </p>
      </div>
    </div>

    <form id="simulate-trade-form" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)) 120px; gap: 0.75rem; align-items: end;">
      <div>
        <label style="display: block; font-size: 0.75rem; color: var(--text-muted); margin-bottom: 4px;">Stock Symbol</label>
        <input type="text" id="trade-symbol" placeholder="e.g. TCS" class="input-field" style="width: 100%; text-transform: uppercase;" required />
      </div>

      <div>
        <label style="display: block; font-size: 0.75rem; color: var(--text-muted); margin-bottom: 4px;">Action</label>
        <select id="trade-side" class="input-field" style="width: 100%;">
          <option value="BUY">BUY</option>
          <option value="SELL">SELL</option>
        </select>
      </div>

      <div>
        <label style="display: block; font-size: 0.75rem; color: var(--text-muted); margin-bottom: 4px;">Quantity</label>
        <input type="number" id="trade-qty" placeholder="e.g. 5" min="1" class="input-field" style="width: 100%;" required />
      </div>

      <div>
        <label style="display: block; font-size: 0.75rem; color: var(--text-muted); margin-bottom: 4px;">Execution Price (₹)</label>
        <input type="number" id="trade-price" placeholder="e.g. 3650" min="1" step="0.01" class="input-field" style="width: 100%;" required />
      </div>

      <button type="submit" class="btn btn-primary" style="height: 42px;">
        Execute
      </button>
    </form>
    <div id="trade-result-msg" style="margin-top: 0.85rem; font-size: 0.85rem; display: none;"></div>
  </div>
</MainLayout>

<script>
  import { executeTrade, DEFAULT_USER_ID } from '../scripts/api.js';

  const tradeForm = document.getElementById('simulate-trade-form') as HTMLFormElement;
  const msgEl = document.getElementById('trade-result-msg') as HTMLDivElement;

  tradeForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const symbol = (document.getElementById('trade-symbol') as HTMLInputElement).value.trim().toUpperCase();
    const side = (document.getElementById('trade-side') as HTMLSelectElement).value;
    const quantity = parseInt((document.getElementById('trade-qty') as HTMLInputElement).value, 10);
    const executionPrice = parseFloat((document.getElementById('trade-price') as HTMLInputElement).value);

    try {
      const result = await executeTrade({
        tradeId: Date.now(),
        userId: DEFAULT_USER_ID,
        stockSymbol: symbol,
        side: side,
        quantity: quantity,
        executionPrice: executionPrice,
        executedAt: new Date().toISOString()
      });

      if (msgEl) {
        msgEl.style.display = 'block';
        msgEl.style.color = '#10b981';
        msgEl.innerHTML = `✓ ${result.message || 'Trade executed successfully! Reloading...'}`;
      }
      setTimeout(() => window.location.reload(), 1200);
    } catch (err: any) {
      if (msgEl) {
        msgEl.style.display = 'block';
        msgEl.style.color = '#ef4444';
        msgEl.innerHTML = `✕ ${err.message || 'Execution failed'}`;
      }
    }
  });
</script>
