---
interface Props {
  title?: string;
  activeNav?: 'portfolio' | 'watchlist';
}

const { title = "Stock Trading Portfolio", activeNav = "portfolio" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Stock Trading App – Member 4: Portfolio & Watchlist Management Module" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Member 4 Portfolio</title>
    <link rel="stylesheet" href="/src/styles/portfolio.css" />
  </head>
  <body>
    <div class="m4-container">
      <!-- Sidebar Navigation -->
      <aside class="m4-sidebar">
        <div class="m4-brand">
          <div class="m4-brand-icon">📈</div>
          <div class="m4-brand-text">
            <h2>TradeHub</h2>
            <span>Member 4: Portfolio</span>
          </div>
        </div>

        <ul class="m4-nav-menu">
          <li>
            <a href="/portfolio" class={`m4-nav-link ${activeNav === 'portfolio' ? 'active' : ''}`}>
              <span>📊</span>
              <span>Portfolio & Holdings</span>
            </a>
          </li>
          <li>
            <a href="/watchlist" class={`m4-nav-link ${activeNav === 'watchlist' ? 'active' : ''}`}>
              <span>⭐</span>
              <span>Watchlist</span>
            </a>
          </li>
          <li>
            <a href="/" class="m4-nav-link">
              <span>💻</span>
              <span>Member 3 Trading Desk</span>
            </a>
          </li>
          <li>
            <a href="http://localhost:8080/swagger-ui.html" target="_blank" rel="noopener noreferrer" class="m4-nav-link">
              <span>📖</span>
              <span>Swagger REST API</span>
            </a>
          </li>
        </ul>

        <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--m4-border-color); font-size: 0.8rem; color: var(--m4-text-muted);">
          <span>Logged in as User 101</span>
        </div>
      </aside>

      <!-- Main Content Area -->
      <div class="m4-main-wrapper">
        <header class="m4-top-header">
          <div class="m4-header-title">
            <h1>{title}</h1>
          </div>
          <div style="display: flex; gap: 0.75rem; align-items: center;">
            <a href="/" class="m4-btn" style="background: rgba(255,255,255,0.06); color: var(--m4-text-secondary); text-decoration: none;">
              Go to Trading Desk
            </a>
            <button class="m4-btn m4-btn-primary" id="refresh-data-btn" onclick="window.location.reload()">
              🔄 Refresh
            </button>
          </div>
        </header>

        <main class="m4-content-body">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
